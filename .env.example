# ============================================================================
# The Lenny Growth Assistant — environment configuration
#
#   cp .env.example .env
#
# The defaults below run the whole app locally on Ollama with no cloud account
# and no secrets. Copy the file, pull the two Ollama models, and start.
# Never commit .env — it is git-ignored.
# ============================================================================

# ---------------------------------------------------------------- REQUIRED --
# Postgres credentials. Used by the db service and to build DATABASE_URL.
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny
POSTGRES_DB=lenny

# Host port for Postgres. Defaults to 5433 rather than 5432 so this stack can run
# alongside an existing local Postgres. Only affects host access (psql, tests,
# running the backend outside Docker) — inside Compose the port is always 5432.
POSTGRES_HOST_PORT=5433

# Connection string used by the backend, Alembic and the ingestion CLI.
#   docker compose  -> host is the service name 'db'
#   running locally -> host is 'localhost'
DATABASE_URL=postgresql+psycopg://lenny:lenny@db:5432/lenny

# Which LLM serves chat: 'ollama' (local, default) or 'anthropic' (cloud).
LLM_PROVIDER=ollama

# Ollama runs on the HOST, not in Compose (it needs GPU/Metal access, and
# containerising it would re-download several GB of models). Containers reach
# the host daemon via host.docker.internal.
#   docker compose  -> http://host.docker.internal:11434
#   running locally -> http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Chat model. ~4.7 GB, comfortable on a normal laptop, and supports tool calling.
#   ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b

# Embedding model for the RAG index. ~274 MB, 768 dimensions.
# The project uses EMBEDDING_MODEL (not OLLAMA_EMBEDDING_MODEL) because the same
# value is used regardless of which LLM serves chat.
#   ollama pull nomic-embed-text
# EMBEDDING_DIMENSIONS must match the model. Changing either requires
# re-running ingestion, because stored vectors must share one dimension.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# ---------------------------------------------------------------- OPTIONAL --
# Cloud provider. Needed when the header/LLM_PROVIDER is set to anthropic.
# Leave blank to run fully locally — /health reports it as unconfigured rather
# than failing. Selecting Anthropic uses ClaudeAgentSDKRuntime (not the router).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# AGENT_RUNTIME is loaded for compatibility but is NOT the runtime dispatcher.
# AgentService picks the runtime from the selected provider:
#   ollama    → router (RouterRuntime)
#   anthropic → claude_agent_sdk (ClaudeAgentSDKRuntime)
AGENT_RUNTIME=router

# Retrieval tuning. RETRIEVAL_MAX_DISTANCE is the cosine-distance ceiling for
# relevance: raise it to retrieve more loosely, lower it to refuse more often.
RETRIEVAL_TOP_K=6
RETRIEVAL_MAX_DISTANCE=0.55
ESSAY_TARGET_WORDS=1250

# Where transcript files are read from, relative to the repo root.
TRANSCRIPTS_DIR=data/transcripts

# Logging: LOG_FORMAT=json for structured logs, 'console' for readable local dev.
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=development

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Base URL the frontend calls. Empty means same-origin via the nginx proxy,
# which is correct under docker compose.
VITE_API_BASE_URL=
